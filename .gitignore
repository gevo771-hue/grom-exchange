.DS_Store

# Dependencies
node_modules
node_modules/
**/node_modules/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
coverage/
.cache/

# WalletConnect bundle scratch (never ship)
.wc-bundle-tmp/

# Runtime data
*.pid
*.seed

# Editor/system
.idea/
.vscode/
*.swp

# Local recovery/build artefacts must not be committed.
*.orig
*.rej
*.bak
frontend/dist.backup*/
frontend/public/*.gz
frontend/public/**/*.gz
frontend/public/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].js
frontend/public/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].css
