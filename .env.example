# ================== GROM EXCHANGE ENV ==================
# All variables use GROM_ prefix to avoid collision with Granium.

NODE_ENV=development

# --- Ports ---
GROM_BACKEND_PORT=4000
GROM_FRONTEND_PORT=5273

# --- Postgres ---
GROM_DB_HOST=postgres
GROM_DB_PORT=5432
GROM_DB_NAME=grom
GROM_DB_USER=grom
GROM_DB_PASSWORD=change_me_strong_password
# Per pm2 worker. 4 workers × 50 ≈ 200 (matches postgres max_connections).
# Do NOT set 100/worker unless you reduce GROM_CLUSTER_WORKERS or raise max_connections.
GROM_DB_POOL_MAX=50

# --- Redis ---
GROM_REDIS_HOST=redis
GROM_REDIS_PORT=6379
GROM_REDIS_NAMESPACE=grom:
GROM_QUOTE_CACHE_TTL_SEC=8

# --- Cluster (pm2) ---
# 0 = all CPUs. Set 1 for single-process debug.
GROM_CLUSTER_WORKERS=0

# --- Auth / Security ---
GROM_JWT_SECRET=change_me_64_chars_min_random_string
GROM_JWT_TTL=86400
GROM_CORS_ORIGIN=http://localhost:5273
# Same host the browser uses (nginx on 5273 → /auth SIWE domain must match).
GROM_SIWE_DOMAIN=localhost:5273
# Local-only: POST /auth/dev-login returns JWT without MetaMask (never enable in production).
GROM_ALLOW_DEV_LOGIN=1

# --- DEX Aggregators (public fee ids — no secrets in browser) ---
GROM_1INCH_API_KEY=
GROM_ODOS_API_URL=https://api.odos.xyz
# Published via GET /api/swap/public-config (non-secret). Unset → aggregator unavailable for fee path.
# GROM_SQUID_INTEGRATOR_ID=your-squid-integrator-id
# GROM_SQUID_FEE_BPS=45
# GROM_ODOS_REFERRAL_CODE=12345
# Jupiter Instant Swap fee mode — MUST be set explicitly (never inferred from empty env):
#   free = no GROM platform fee (network/route fees still apply); no map/owner/RPC required
#   fee  = strict 20 bps; requires GROM_JUP_FEE_ACCOUNTS_JSON + GROM_JUP_FEE_OWNER + SOLANA_RPC_URL
# Prod (temporary): GROM_JUP_FEE_MODE=free
GROM_JUP_FEE_MODE=free
# Per-mint Jupiter fee token accounts (mint → initialized SPL token account). Required only when mode=fee.
# GROM_JUP_FEE_ACCOUNTS_JSON={"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v":"YourUsdcFeeTokenAccount","So11111111111111111111111111111111111111112":"YourWsolFeeTokenAccount"}
# Wallet that must own every fee token account (parsed.info.owner)
# GROM_JUP_FEE_OWNER=YourFeeAuthorityPubkey
# Solana JSON-RPC required for fee-account verification in fee mode (fail-closed without it)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GROM_FEE_RECEIVER=0xCFeF272536D6E91A4945063d40ac7CbA7Eb657B5
GROM_FEE_BPS=20

# --- Web3 Wallet ---
GROM_WALLETCONNECT_PROJECT_ID=
GROM_SUPPORTED_CHAINS=1,137,56,42161,8453
GROM_SIWE_STATEMENT=Sign in to GROM Exchange

# --- Polymarket Builders (predict) ---
# Public bytes32 from polymarket.com → Settings → Builders (0x + 64 hex).
GROM_POLYMARKET_BUILDER_CODE=

# Hyperliquid Spot (L1 CLOB) + Perp builder fees — keep; not CEX
GROM_HL_BUILDER_ADDRESS=
GROM_HL_BUILDER_FEE_TENTHS_BP=50
GROM_HL_MAX_APPROVE_FEE_PCT=0.1%
GROM_HL_TESTNET=false

# --- Observability ---
GROM_LOG_LEVEL=info
GROM_METRICS_PORT=9464
GROM_PROMETHEUS_URL=http://prometheus:9090

# --- Geoblock (ISO country codes, comma separated, blocked). Empty = disabled (good for local dev). ---
GROM_GEOBLOCK=

# --- Product: wallet-only + Hyperliquid Spot/Perp + Instant Swap ---
# Auth is SIWE / WalletConnect. No retired desks, custodial ledger, email/2FA, or third-party fiat rails.
